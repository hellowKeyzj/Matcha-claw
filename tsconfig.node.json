{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "outDir": "dist-electron",
    "declaration": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Paths */
    "baseUrl": ".",
    "paths": {
      "@electron/*": ["electron/*"],
      "@electron/e2e-fixture-loader": ["electron/main/e2e-fixture-loader.noop.ts"]
    }
  },
  "include": ["electron", "src/types/desktop", "src/types/session-goal.ts", "src/types/team-design.ts", "src/types/call-log.ts", "src/types/runtime-repair.ts", "src/types/call-log/**/*.ts", "src/types/provider-runtime-report.ts", "src/types/connectors-observation.ts", "src/types/connectors-oauth.ts", "src/types/plugins.ts", "src/types/network-search.ts", "src/types/session-permission.ts", "src/types/openclaw-question.ts", "src/types/skills-operation-result.ts", "src/types/wiki-call-result.ts", "src/types/cron-operation-result.ts", "src/types/cloud-package-operation.ts", "src/types/cloud-package.ts", "src/types/cron.ts", "src/types/channel.ts", "src/lib/host-api-transport-contract.ts", "src/lib/error-model.ts", "src/types/board.ts", "src/types/openclaw-browser.ts", "src/types/openclaw-runtime-surface.ts", "src/types/runtime-topology.ts", "src/types/session-question.ts", "src/types/session-thinking.ts", "src/types/skill.ts", "src/types/world-initial.ts", "src/types/world-access.ts", "src/types/world-evaluation.ts", "src/types/world-storage.ts", "src/types/world.ts", "src/types/native-policy.ts", "src/types/session/snapshot.ts", "src/types/session/render-item.ts", "src/types/session/runtime-state.ts", "src/types/session/task-snapshot.ts", "src/types/session/tool-card.ts", "src/types/wiki-capabilities.ts", "src/types/wiki-selection.ts", "vite.config.ts"]
}
