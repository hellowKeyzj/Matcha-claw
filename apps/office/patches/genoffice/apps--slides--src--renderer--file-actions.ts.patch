+// Timer ownership stays in the mounted panel; save/leave only requests its pending work.
+const pendingPanels = new Set<{ flush(): void; cancel(): void; pending(): boolean }>()
+export const hasPendingEdits = (): boolean => [...pendingPanels].some(panel => panel.pending())
+export function flushPendingEdits(): void { for (const panel of pendingPanels) panel.flush() }
+export function cancelPendingEdits(): void { for (const panel of pendingPanels) panel.cancel() }
+export function usePendingEdits() {
+  const owner = useRef<{ jobs: Map<number, () => void>; flush(): void; cancel(): void; pending(): boolean } | null>(null)
+  if (!owner.current) {
+    const jobs = new Map<number, () => void>()
+    owner.current = {
+      jobs,
+      flush() { for (const [id, fire] of [...jobs]) { window.clearTimeout(id); jobs.delete(id); fire() } },
+      cancel() { for (const id of jobs.keys()) window.clearTimeout(id); jobs.clear() },
+      pending() { return jobs.size > 0 },
+    }
+  }
+  const panel = owner.current
+  useEffect(() => {
+    pendingPanels.add(panel)
+    return () => { panel.flush(); pendingPanels.delete(panel) }
+  }, [panel])
+  return {
+    schedule(fire: () => void, delay: number): number {
+      const id = window.setTimeout(() => { panel.jobs.delete(id); fire() }, delay)
+      panel.jobs.set(id, fire)
+      return id
+    },
+    cancel(id: number): void { window.clearTimeout(id); panel.jobs.delete(id) },
+  }
+}
 
