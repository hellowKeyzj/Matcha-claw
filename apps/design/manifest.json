              { "properties": { "sourceLayerIds": { "type": "array", "maxItems": 1 }, "referenceAssetIds": { "type": "array", "maxItems": 3 } } },
              { "properties": { "sourceLayerIds": { "type": "array", "maxItems": 2 }, "referenceAssetIds": { "type": "array", "maxItems": 2 } } },
              { "properties": { "sourceLayerIds": { "type": "array", "maxItems": 3 }, "referenceAssetIds": { "type": "array", "maxItems": 1 } } },
              { "properties": { "sourceLayerIds": { "type": "array", "maxItems": 4 }, "referenceAssetIds": { "type": "array", "maxItems": 0 } } }
            ] }
          }]
        },
        "_meta": { "ui": { "resourceUri": "ui://app-plugins/matcha.design/editor", "visibility": ["model", "app"] } }
      },
      {
        "name": "templates",
        "description": "List, save or remove local design templates using user-supplied assets. Save requires an already imported image asset and creates a template in product-scene, model or logo-technique; no licensed stock library is included and no remote catalog, image download or model generation is performed.",
