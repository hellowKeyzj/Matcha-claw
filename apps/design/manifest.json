{
  "schemaVersion": 1,
  "apiVersion": 1,
  "minSdkVersion": "1.6.0",
  "id": "matcha.design",
  "name": "Matcha 设计",
  "version": "1.0.12",
  "description": "会话工作区画板：自由画布、图层、文字、图片编辑、用户自带素材、模型生成、多镜头生成与合成及本地导出。每个会话独立保存。",
  "main": "main.cjs",
  "contributes": {
    "chat": { "contextTag": "mcp_app_model_context" },
    "applications": [{ "id": "editor", "name": "设计画板", "icon": { "paths": ["M13 4H5a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h13a2 2 0 0 0 2-2v-8", "m17 3 4 4-9 9-5 1 1-5ZM15 5l4 4"] }, "entry": "editor.html", "placement": "chat-panel", "imageEditor": { "label": "画布编辑", "tool": "image_open", "translations": { "en": "Edit on canvas", "ja": "キャンバスで編集", "ru": "Редактировать на холсте" } } }],
    "tools": [
      {
        "name": "documents_list",
        "description": "List saved design documents with their IDs, dimensions and current revisions. With sessionIdentity, return only that exact runtime endpoint, agent and session's workspace.",
        "inputSchema": {
          "type": "object", "properties": { "sessionIdentity": { "$ref": "#/$defs/sessionIdentity" } }, "additionalProperties": false,
          "$defs": {
            "identity": { "type": "string", "pattern": "^[^\\u0000]*[^\\s\\u0000][^\\u0000]*$" },
            "sessionIdentity": {
              "type": "object", "additionalProperties": false, "required": ["endpoint", "agentId", "sessionKey"],
              "properties": {
                "agentId": { "$ref": "#/$defs/identity" }, "sessionKey": { "$ref": "#/$defs/identity" },
                "endpoint": { "oneOf": [
                  { "type": "object", "additionalProperties": false, "required": ["kind", "runtimeAdapterId", "runtimeInstanceId"], "properties": { "kind": { "const": "native-runtime" }, "runtimeAdapterId": { "$ref": "#/$defs/identity" }, "runtimeInstanceId": { "$ref": "#/$defs/identity" } } },
                  { "type": "object", "additionalProperties": false, "required": ["kind", "protocolId", "connectorId", "endpointId"], "properties": { "kind": { "const": "protocol-connector" }, "protocolId": { "$ref": "#/$defs/identity" }, "connectorId": { "$ref": "#/$defs/identity" }, "endpointId": { "$ref": "#/$defs/identity" } } }
                ] }
              }
            }
          }
        },
        "_meta": { "ui": { "resourceUri": "ui://app-plugins/matcha.design/editor", "visibility": ["model", "app"] } }
      },
      {
        "name": "document_create",
        "description": "Open or create the free-canvas workspace for a complete sessionIdentity. workspaceDraftId identifies an opaque workspace draft, not authorization: repeated calls open that same draft, and adding sessionIdentity binds its original document without clearing edits or history. Conflicting session/documents are not merged or replaced. With neither identity, create a new independent document. Empty export dimensions default to 1024 × 1024 pixels; content may extend beyond them.",
        "inputSchema": {
          "type": "object", "additionalProperties": false,
          "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 200 }, "width": { "type": "number", "minimum": 1, "maximum": 32768 }, "height": { "type": "number", "minimum": 1, "maximum": 32768 }, "sessionIdentity": { "$ref": "#/$defs/sessionIdentity" }, "workspaceDraftId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,128}$" } },
          "$defs": {
            "identity": { "type": "string", "pattern": "^[^\\u0000]*[^\\s\\u0000][^\\u0000]*$" },
            "sessionIdentity": {
              "type": "object", "additionalProperties": false, "required": ["endpoint", "agentId", "sessionKey"],
              "properties": {
                "agentId": { "$ref": "#/$defs/identity" }, "sessionKey": { "$ref": "#/$defs/identity" },
                "endpoint": { "oneOf": [
                  { "type": "object", "additionalProperties": false, "required": ["kind", "runtimeAdapterId", "runtimeInstanceId"], "properties": { "kind": { "const": "native-runtime" }, "runtimeAdapterId": { "$ref": "#/$defs/identity" }, "runtimeInstanceId": { "$ref": "#/$defs/identity" } } },
                  { "type": "object", "additionalProperties": false, "required": ["kind", "protocolId", "connectorId", "endpointId"], "properties": { "kind": { "const": "protocol-connector" }, "protocolId": { "$ref": "#/$defs/identity" }, "connectorId": { "$ref": "#/$defs/identity" }, "endpointId": { "$ref": "#/$defs/identity" } } }
                ] }
              }
            }
          }
        },
        "_meta": { "ui": { "resourceUri": "ui://app-plugins/matcha.design/editor", "visibility": ["model", "app"] } }
      },
      {
        "name": "image_open",
        "description": "Import actual image bytes and insert them to the right of the complete sessionIdentity's saved design workspace. Opens or creates that exact session document idempotently without requiring the editor UI. Returns the document and inserted layerId; does not call a paid model. data is raw padded base64, not a data URL.",
        "inputSchema": {
          "type": "object", "additionalProperties": false, "required": ["sessionIdentity", "name", "mimeType", "data"],
          "properties": { "sessionIdentity": { "$ref": "#/$defs/sessionIdentity" }, "name": { "type": "string", "minLength": 1, "maxLength": 200 }, "mimeType": { "enum": ["image/png", "image/jpeg", "image/webp", "image/gif", "image/svg+xml"] }, "data": { "type": "string", "minLength": 1 } },
          "$defs": {
            "identity": { "type": "string", "pattern": "^[^\\u0000]*[^\\s\\u0000][^\\u0000]*$" },
            "sessionIdentity": {
              "type": "object", "additionalProperties": false, "required": ["endpoint", "agentId", "sessionKey"],
              "properties": {
                "agentId": { "$ref": "#/$defs/identity" }, "sessionKey": { "$ref": "#/$defs/identity" },
                "endpoint": { "oneOf": [
                  { "type": "object", "additionalProperties": false, "required": ["kind", "runtimeAdapterId", "runtimeInstanceId"], "properties": { "kind": { "const": "native-runtime" }, "runtimeAdapterId": { "$ref": "#/$defs/identity" }, "runtimeInstanceId": { "$ref": "#/$defs/identity" } } },
                  { "type": "object", "additionalProperties": false, "required": ["kind", "protocolId", "connectorId", "endpointId"], "properties": { "kind": { "const": "protocol-connector" }, "protocolId": { "$ref": "#/$defs/identity" }, "connectorId": { "$ref": "#/$defs/identity" }, "endpointId": { "$ref": "#/$defs/identity" } } }
                ] }
              }
            }
          }
        },
        "_meta": { "ui": { "resourceUri": "ui://app-plugins/matcha.design/editor", "visibility": ["model", "app"] } }
      },
      {
        "name": "document_get",
        "description": "Read a complete design document. Use its revision for subsequent edits, history operations or export.",
        "inputSchema": { "type": "object", "additionalProperties": false, "required": ["documentId"], "properties": { "documentId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,128}$" } } },
        "_meta": { "ui": { "resourceUri": "ui://app-plugins/matcha.design/editor", "visibility": ["model", "app"] } }
      },
      {
        "name": "document_edit",
        "description": "Atomically apply an ordered edit batch at expectedRevision. Revision conflicts never overwrite newer edits. Reorder supplies every layer ID in bottom-to-top order. An inserted layer requires all geometry, visibility and type-specific fields. Image-only crop, flipX/flipY, lockAspectRatio, adjustments, stroke and shadow persist in this same document history without rewriting asset bytes. Optional nested objects replace the complete previous value, require all their fields and cannot be null; omitted fields remain unchanged in a patch and have no stored defaults. Crop uses a half-open rectangle in original asset pixels and must fit the source dimensions.",
        "inputSchema": {
          "type": "object", "additionalProperties": false, "required": ["documentId", "expectedRevision", "edits"],
          "properties": {
            "documentId": { "$ref": "#/$defs/id" }, "expectedRevision": { "type": "integer", "minimum": 0 },
            "edits": { "type": "array", "minItems": 1, "maxItems": 1024, "items": {
              "oneOf": [
                { "type": "object", "additionalProperties": false, "required": ["type", "layer"], "properties": { "type": { "const": "insert" }, "layer": { "$ref": "#/$defs/layer" }, "source": { "const": "session-media", "description": "Automatic session media intake; records the immutable asset as consumed even after layer removal or undo." } }, "allOf": [{ "if": { "required": ["source"], "properties": { "source": {} } }, "then": { "properties": { "layer": { "type": "object", "properties": { "type": { "enum": ["image", "video"] } } } } } }] },
                { "type": "object", "additionalProperties": false, "required": ["type", "id", "changes"], "properties": { "type": { "const": "patch" }, "id": { "$ref": "#/$defs/id" }, "changes": { "$ref": "#/$defs/patch" } } },
                { "type": "object", "additionalProperties": false, "required": ["type", "ids"], "properties": { "type": { "enum": ["remove", "reorder"] }, "ids": { "$ref": "#/$defs/ids" } } },
                { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "const": "canvas" }, "name": { "type": "string", "minLength": 1, "maxLength": 200 }, "width": { "type": "number", "minimum": 1, "maximum": 32768 }, "height": { "type": "number", "minimum": 1, "maximum": 32768 }, "background": { "type": ["string", "null"], "maxLength": 500 } } }
              ]
            } }
          },
          "$defs": {
            "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,128}$" },
            "ids": { "type": "array", "maxItems": 2048, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
            "crop": {
              "type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"],
              "description": "Half-open rectangle in original asset pixels; preserves the original asset bytes. Must fit the source asset dimensions.",
              "properties": { "x": { "type": "number", "minimum": 0, "maximum": 32768 }, "y": { "type": "number", "minimum": 0, "maximum": 32768 }, "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 32768 }, "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 32768 } }
            },
            "adjustments": {
              "type": "object", "additionalProperties": false, "required": ["blur", "brightness", "contrast", "hue", "saturation", "invert"],
              "properties": { "blur": { "type": "number", "minimum": 0, "maximum": 100 }, "brightness": { "type": "number", "minimum": -100, "maximum": 100 }, "contrast": { "type": "number", "minimum": -100, "maximum": 100 }, "hue": { "type": "number", "minimum": -100, "maximum": 100 }, "saturation": { "type": "number", "minimum": -100, "maximum": 100 }, "invert": { "type": "boolean" } }
            },
            "stroke": {
              "type": "object", "additionalProperties": false, "required": ["color", "width", "opacity"],
              "properties": { "color": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S" }, "width": { "type": "number", "minimum": 0, "maximum": 32768 }, "opacity": { "type": "number", "minimum": 0, "maximum": 1 } }
            },
            "shadow": {
              "type": "object", "additionalProperties": false, "required": ["color", "blur", "offsetX", "offsetY", "opacity"],
              "properties": { "color": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S" }, "blur": { "type": "number", "minimum": 0, "maximum": 32768 }, "offsetX": { "type": "number", "minimum": -1000000, "maximum": 1000000 }, "offsetY": { "type": "number", "minimum": -1000000, "maximum": 1000000 }, "opacity": { "type": "number", "minimum": 0, "maximum": 1 } }
            },
            "patch": {
              "type": "object", "additionalProperties": false,
              "properties": {
                "name": { "type": "string", "maxLength": 200 },
                "x": { "type": "number", "minimum": -1000000, "maximum": 1000000 }, "y": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
                "width": { "type": "number", "minimum": 0.01, "maximum": 32768 }, "height": { "type": "number", "minimum": 0.01, "maximum": 32768 },
                "rotation": { "type": "number", "minimum": -360000, "maximum": 360000 }, "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
                "visible": { "type": "boolean" }, "locked": { "type": "boolean" }, "assetId": { "$ref": "#/$defs/id" },
                "crop": { "$ref": "#/$defs/crop" }, "flipX": { "type": "boolean" }, "flipY": { "type": "boolean" }, "lockAspectRatio": { "type": "boolean" },
                "adjustments": { "$ref": "#/$defs/adjustments" }, "stroke": { "$ref": "#/$defs/stroke" }, "shadow": { "$ref": "#/$defs/shadow" },
                "text": { "type": "string", "maxLength": 100000 }, "fontFamily": { "type": "string", "minLength": 1, "maxLength": 500 },
                "fontSize": { "type": "number", "minimum": 0.1, "maximum": 4096 }, "fontStyle": { "enum": ["normal", "bold", "italic", "bold italic"] },
                "fill": { "type": "string", "minLength": 1, "maxLength": 500 }, "align": { "enum": ["left", "center", "right"] }, "lineHeight": { "type": "number", "minimum": 0.1, "maximum": 20 }
              }
            },
            "layer": {
              "type": "object", "additionalProperties": false,
              "required": ["id", "type", "name", "x", "y", "width", "height", "rotation", "opacity", "visible", "locked"],
              "properties": {
                "id": { "$ref": "#/$defs/id" }, "type": { "enum": ["image", "video", "text"] }, "name": { "type": "string", "minLength": 1, "maxLength": 200 },
                "x": { "type": "number", "minimum": -1000000, "maximum": 1000000 }, "y": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
                "width": { "type": "number", "minimum": 0.01, "maximum": 32768 }, "height": { "type": "number", "minimum": 0.01, "maximum": 32768 },
                "rotation": { "type": "number", "minimum": -360000, "maximum": 360000 }, "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
                "visible": { "type": "boolean" }, "locked": { "type": "boolean" }, "assetId": { "$ref": "#/$defs/id" },
                "crop": { "$ref": "#/$defs/crop" }, "flipX": { "type": "boolean" }, "flipY": { "type": "boolean" }, "lockAspectRatio": { "type": "boolean" },
                "adjustments": { "$ref": "#/$defs/adjustments" }, "stroke": { "$ref": "#/$defs/stroke" }, "shadow": { "$ref": "#/$defs/shadow" },
                "text": { "type": "string", "maxLength": 100000 }, "fontFamily": { "type": "string", "minLength": 1, "maxLength": 500 },
                "fontSize": { "type": "number", "minimum": 0.1, "maximum": 4096 }, "fontStyle": { "enum": ["normal", "bold", "italic", "bold italic"] },
                "fill": { "type": "string", "minLength": 1, "maxLength": 500 }, "align": { "enum": ["left", "center", "right"] }, "lineHeight": { "type": "number", "minimum": 0.1, "maximum": 20 }
              },
              "allOf": [{
                "if": { "properties": { "type": { "const": "text" } }, "required": ["type"] },
                "then": { "required": ["text", "fontFamily", "fontSize", "fontStyle", "fill", "align", "lineHeight"], "properties": { "text": {}, "fontFamily": {}, "fontSize": {}, "fontStyle": {}, "fill": {}, "align": {}, "lineHeight": {}, "assetId": false } },
                "else": { "required": ["assetId"], "properties": { "assetId": { "type": "string" }, "text": false, "fontFamily": false, "fontSize": false, "fontStyle": false, "fill": false, "align": false, "lineHeight": false } }
              }, {
                "if": { "properties": { "type": { "const": "image" } }, "required": ["type"] },
                "then": { "properties": { "crop": {}, "flipX": {}, "flipY": {}, "lockAspectRatio": {}, "adjustments": {}, "stroke": {}, "shadow": {} } },
                "else": { "properties": { "crop": false, "flipX": false, "flipY": false, "lockAspectRatio": false, "adjustments": false, "stroke": false, "shadow": false } }
              }]
            }
          }
        },
        "_meta": { "ui": { "resourceUri": "ui://app-plugins/matcha.design/editor", "visibility": ["model", "app"] } }
      },
      {
        "name": "document_undo",
        "description": "Undo the last saved edit without overwriting a newer revision.",
        "inputSchema": { "type": "object", "additionalProperties": false, "required": ["documentId", "expectedRevision"], "properties": { "documentId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,128}$" }, "expectedRevision": { "type": "integer", "minimum": 0 } } },
        "_meta": { "ui": { "resourceUri": "ui://app-plugins/matcha.design/editor", "visibility": ["model", "app"] } }
      },
      {
        "name": "document_redo",
        "description": "Redo a previously undone edit at the current revision.",
        "inputSchema": { "type": "object", "additionalProperties": false, "required": ["documentId", "expectedRevision"], "properties": { "documentId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,128}$" }, "expectedRevision": { "type": "integer", "minimum": 0 } } },
        "_meta": { "ui": { "resourceUri": "ui://app-plugins/matcha.design/editor", "visibility": ["model", "app"] } }
      },
      {
        "name": "asset_import",
        "description": "Import actual image or video bytes. data is plain base64, not a data URL. Use the returned asset ID in matching image/video layers or use an image asset as a generation reference.",
        "inputSchema": { "type": "object", "additionalProperties": false, "required": ["name", "mimeType", "data"], "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 200 }, "mimeType": { "type": "string", "minLength": 1, "maxLength": 100 }, "data": { "type": "string", "minLength": 1 } } },
        "_meta": { "ui": { "resourceUri": "ui://app-plugins/matcha.design/editor", "visibility": ["model", "app"] } }
      },
      {
        "name": "asset_read",
        "description": "Read a stored asset's metadata and actual bytes as plain base64.",
        "inputSchema": { "type": "object", "additionalProperties": false, "required": ["assetId"], "properties": { "assetId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,128}$" } } },
        "_meta": { "ui": { "resourceUri": "ui://app-plugins/matcha.design/editor", "visibility": ["model", "app"] } }
      },
      {
        "name": "document_export",
        "description": "Render a saved revision to a persisted PNG, JPEG or WebP asset without an open UI. Export uses actual visible content bounds, including rotation and content beyond the empty canvas size. Supply one layer ID to export that image alone; export individual images separately for a ZIP. Omit layerIds to render all visible content. Read the returned asset ID to download actual bytes for local export; no hosted sharing link is created.",
        "inputSchema": {
          "type": "object", "additionalProperties": false, "required": ["documentId", "expectedRevision", "format"],
          "properties": {
            "documentId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,128}$" }, "expectedRevision": { "type": "integer", "minimum": 0 },
            "format": { "enum": ["png", "jpeg", "webp"] }, "scale": { "type": "number", "minimum": 0.01, "maximum": 8 },
            "layerIds": { "type": "array", "maxItems": 2048, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,128}$" } }, "background": { "type": "string", "minLength": 1, "maxLength": 500 }
          }
        },
        "_meta": { "ui": { "resourceUri": "ui://app-plugins/matcha.design/editor", "visibility": ["model", "app"] } }
      },
      {
        "name": "media_models",
        "description": "List configured media models for kind through Matcha's existing model boundary. Returns the models.list DTO: models with canonical selectionId, name and supported limits (maxImages, maxCount, mask, pixelSize, optional sizes/durationsSeconds and storyboard:false), plus optional defaultSelectionId. Use these actual capabilities before generation; no provider URL, credentials or native task handle is exposed.",
        "inputSchema": { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "enum": ["image", "video"] } } },
        "_meta": { "ui": { "resourceUri": "ui://app-plugins/matcha.design/editor", "visibility": ["model", "app"] } }
      },
      {
        "name": "generate",
        "description": "Generate images/videos with private configured models. For each context/request call toolName with {...request,prompt:[request.prompt,context.prompt].filter(Boolean).join('\\n\\n')}; keep empty current input; other text only supplements, never replaces it. Edits need real image layers. Crop becomes PNG; uncropped PNG/JPEG/WebP retain bytes, SVG/GIF become PNG. Downloads stay original. remove-background/upscale/erase/white/watermark/resize/translate/edit-text/angle/erase-text need one explicit sourceLayerIds entry; call separately per image. angle uses anglePreset, preserves identity, changes view/framing. erase-text removes all text; watermark preserves product text. Neither needs OCR. Only video/storyboard accept ordered referenceAssetIds after sources; total <=16 and model.maxImages. No ultra upscale. logo needs 1-15 products then logoAssetId; material is optional technique. model-display permits modelAssetId after <=15 products, otherwise <=16 sources. recolor needs 1-8 colors, integer opacity %. resize needs aspectRatio; resize/upscale compute pixels from effective crop, reject size. translate needs targetLanguage. edit-text needs text_extract's markedAssetId, sourceAssetId as expectedSourceAssetId, exact sourceCrop as expectedSourceCrop (null if uncropped), 1-200 textEdits; changed source/crop fails before execution; empty edited deletes text; cannot mix annotation/logo/model. edit/erase annotationAssetId is same-size purple-marked PNG; pass expectedSourceAssetId/expectedSourceCrop and one source. Model inputs: annotated edit=annotation then original; erase/edit-text=marked image only. Remove marks; unchanged pixels elsewhere not guaranteed. storyboard generates scenes independently then FFmpeg composes MP4; no cross-shot identity/style guarantee. May incur charges. Cancellation stops local waiting, not guaranteed upstream stop/undo/refund. Outputs and failed/interrupted/cancelled records persist; never automatically retry unknown paid outcomes.",
        "inputSchema": {
          "description": "Parameters for one generation request. In a compose context, each requests entry supplies these arguments; document and attachment metadata are not additional tool arguments.",
          "type": "object", "additionalProperties": false, "required": ["documentId", "action", "prompt"],
          "properties": {
            "documentId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,128}$", "description": "Target design document ID (operation.document.id in a compose context). Source layers belong to this document; outputs are added as new layers." },
            "action": { "enum": ["image", "edit", "remove-background", "upscale", "erase", "product-scene", "recolor", "model-display", "logo", "video", "storyboard", "white", "watermark", "resize", "translate", "edit-text", "angle", "erase-text"], "description": "Operation to execute. Scene-video and multi-shot recommendations use video." },
            "prompt": { "type": "string", "maxLength": 20000, "description": "Generation instructions for this request; image/edit/product-scene/video require nonblank text. For storyboard, the overall style applied before each shot's prompt." },
            "sourceLayerIds": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,128}$" }, "description": "Ordered image-layer IDs from the target document. Generation uses each asset with its crop, without canvas transforms or visual effects. When omission is allowed, image-dependent actions use all visible image layers; image/video/storyboard use none. An empty array selects no layers." },
            "referenceAssetIds": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,128}$" }, "description": "Ordered independent image-asset IDs for video/storyboard." },
            "anglePreset": { "enum": ["front", "back", "god", "side", "three-quarter-left", "three-quarter-right", "low-angle", "face-closeup", "environment"], "description": "Camera view or framing for angle, rather than canvas rotation." },
            "logoAssetId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,128}$", "description": "Logo artwork asset ID for logo." },
            "material": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S", "description": "Optional logo application technique or finish, such as embroidery, engraving or printing." },
            "modelAssetId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,128}$", "description": "Optional person-reference asset for model-display. Without it, the prompt describes the person's appearance; an empty prompt uses built-in guidance." },
            "annotationAssetId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,128}$", "description": "Purple rectangle/brush-marked PNG for edit/erase, at the original source asset's full dimensions. The source crop is also applied to this PNG; marks indicate edit positions rather than an alpha mask." },
            "markedAssetId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,128}$", "description": "Red-boxed PNG returned by text_extract for edit-text. Already matches the effective source crop and is not cropped again." },
            "expectedSourceAssetId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,128}$", "description": "Original source asset ID when the marks were created. For edit-text, use text_extract.sourceAssetId." },
            "expectedSourceCrop": { "description": "Crop snapshot when the marks were created: a half-open rectangle in original asset pixels, or null if uncropped. For edit-text, use text_extract.sourceCrop unchanged.", "anyOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"], "properties": { "x": { "type": "number", "minimum": 0, "maximum": 32768, "description": "Left edge in pixels." }, "y": { "type": "number", "minimum": 0, "maximum": 32768, "description": "Top edge in pixels." }, "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 32768, "description": "Width in pixels." }, "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 32768, "description": "Height in pixels." } } }] },
