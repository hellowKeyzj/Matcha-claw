          }, {
            "if": { "properties": { "kind": { "const": "scene-video" } }, "required": ["kind"] },
            "then": { "anyOf": [
              { "properties": { "sourceLayerIds": { "type": "array", "maxItems": 1 }, "referenceAssetIds": { "type": "array", "maxItems": 0 } } },
              { "properties": { "sourceLayerIds": { "type": "array", "maxItems": 0 }, "referenceAssetIds": { "type": "array", "maxItems": 1 } } }
            ] }
          }, {
            "if": { "properties": { "kind": { "const": "multi-shot" } }, "required": ["kind"] },
            "then": { "anyOf": [
