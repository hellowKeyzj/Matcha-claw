    "@serenity-js/playwright": "3.49.0",
    "@serenity-js/playwright-test": "3.49.0",
    "@serenity-js/web": "3.49.0",
    "@types/node": "24.10.0",
    "eslint": "9.39.1",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-boundaries": "7.1.0",
    "playwright-core": "1.64.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0"
  }
