{
  "id": "browser-relay",
  "name": "Browser Relay",
  "version": "0.1.0",
  "category": "tools",
  "description": "Browser control through the selected in-app browser or local Chrome extension relay.",
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "browser"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "mode": {
        "type": "string",
        "enum": ["iab", "relay"],
        "default": "relay"
      },
      "port": {
        "type": "integer",
        "minimum": 1,
        "maximum": 65535,
        "default": 9236
      }
    }
  }
}
