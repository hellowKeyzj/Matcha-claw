package matcha:%world@1.0.0;

interface types {
    record world-ref { tenant-id: string, world-id: string }
    record revision-ref { %world: world-ref, id: string, revision: u64 }
    type definition-ref = revision-ref;
    type assertion-ref = revision-ref;
    type evidence-ref = revision-ref;
    type support-ref = revision-ref;
    type schema-ref = revision-ref;
    type mapping-ref = revision-ref;
    type identity-rule-ref = revision-ref;
    record blob-ref { digest: string, byte-size: u64 }
    record contract-ref { id: string, version: string, schema-digest: string }
    record valid-time { %from: string, to: option<string> }
    record unit { code: string, dimension: string }
    record money { amount: string, currency: string }
    record quantity { amount: string, unit: unit }
    record business-date { value: string, calendar: string }
    record value-field { name: string, node: u32 }
    variant value-node { null, boolean(bool), integer(s64), decimal(string), text(string), money(money), quantity(quantity), timestamp(string), date(business-date), duration(u64), object(string), relation(string), %list(list<u32>), %record(list<value-field>) }
    // Postorder canonical tree: root is last, children precede parents, each nonroot has exactly one parent.
    // Maximum 4096 nodes / 64 levels; no cycles, sharing, unreachable nodes or duplicate record fields.
    record value { nodes: list<value-node>, root: u32 }
    record decimal-type { precision: u16, scale: u16 }
    record list-type { element: u32, max-items: u32 }
    record type-field { name: string, node: u32, nullable: bool, optional: bool }
    variant type-node { null, boolean, integer, decimal(decimal-type), text(u32), money(string), quantity(unit), timestamp(string), date(string), duration, object(string), relation(string), %list(list-type), %record(list<type-field>) }
    record value-type { nodes: list<type-node>, root: u32 }
    variant subject { object(string), relation(string) }
    enum unknown-reason { not-observed, unmapped, needs-evidence, unsupported, incomplete-coverage, pending-recomputation }
    record watch-dependency { id: string, generation: u64 }
    record dirty-detail { generation: u64, invalidated-at: string, watches: list<string> }
    variant dirty-state { clean, dirty(dirty-detail) }
    record unavailable { source-id: string, failure: source-failure }
    variant cell { known(value), unknown(unknown-reason), conflicted(list<assertion-ref>), source-unavailable(unavailable) }
    record field-cell { property: definition-ref, cell: cell, evidence: list<evidence-ref>, dirty: dirty-state }
    record projected-cell { subject: subject, field: field-cell }
    record attribute-claim { subject: subject, property: definition-ref, value: value }
    record role-binding { role: string, object-id: string }
    record relation-claim { relation-id: string, relation-type: definition-ref, roles: list<role-binding> }
    variant claim { attribute(attribute-claim), relation(relation-claim) }
    enum polarity { positive, negative }
    record authority-ref { policy-id: string, revision: u64, fields: list<string>, roles: list<string> }
    record source-position { source-id: string, incarnation: string, partition: string, format: string, cursor: string, transaction: option<string>, event-index: option<u64> }
    record source-origin { binding: definition-ref, authority: authority-ref, position: option<source-position> }
    record extraction-origin { run-id: string, model-call-id: option<string> }
    variant assertion-origin { source(source-origin), derived, human-observation(string), extraction(extraction-origin) }
    enum assertion-status { candidate, accepted, rejected, withdrawn }
    record assertion { reference: assertion-ref, scope: string, claim: claim, polarity: polarity, valid-time: valid-time, recorded-at: string, superseded-at: option<string>, status: assertion-status, origin: assertion-origin, evidence: list<evidence-ref>, supersedes: option<assertion-ref> }
    record observation-draft { claim: claim, polarity: polarity, scope: string, valid-time: valid-time, observed-at: string, origin: assertion-origin, evidence: list<evidence-ref>, supersedes: option<assertion-ref> }
    record owned-roles { relation-type: definition-ref, roles: list<string> }
    variant authority-ownership { properties(list<definition-ref>), relation-roles(owned-roles) }
    record source-authority { incarnation: string, %world: world-ref, source-id: string, binding: definition-ref, authority: authority-ref, scope: string, valid-time: valid-time, recorded-at: string, ownership: authority-ownership }
    record source-read-dependency { position: source-position, binding: definition-ref }
    record identity-dependency { subject: subject, revision: u64 }
    record alias-dependency { digest: string, generation: u64 }
    record mapping-dependency { mapping: mapping-ref, identity-rule: identity-rule-ref, authority: authority-ref, binding: definition-ref }
    record source-field-dependency { schema: schema-ref, field: string, value-type: value-type, nullable: bool, optional: bool, name: string }
    variant read-dependency { assertion(assertion-ref), evidence(evidence-ref), definition(definition-ref), watch(watch-dependency), source(source-read-dependency), time-boundary(string), identity(identity-dependency), alias-range(alias-dependency), source-mapping(mapping-dependency), source-field(source-field-dependency) }
    variant premise { assertion(assertion-ref), evidence(evidence-ref), read(read-dependency) }
    enum support-status { valid, invalid, pending }
    record support-set { reference: support-ref, conclusion: assertion-ref, rule: definition-ref, arguments: list<query-argument>, scope: string, valid-time: valid-time, release-id: string, branch-id: option<string>, premises: list<premise>, status: support-status, dirty: dirty-state }
    enum source-guarantee { projection, authoritative, recorded-replay, assumed }
    enum gap-reason { position-expired, non-replayable, incomplete-enumeration, permission-narrowed, schema-drift, interrupted-snapshot }
    record source-gap { reason: gap-reason, after: option<source-position>, before: option<source-position> }
    record source-basis { source-id: string, incarnation: string, binding: definition-ref, mapping-revision: u64, authority-revision: u64, schema: schema-ref, identity-rule: identity-rule-ref, field-definitions: list<definition-ref>, position: option<source-position>, snapshot: option<string>, observed-at: string, captured-at: option<string>, last-reconciled-at: option<string>, guarantee: source-guarantee, gap: option<source-gap> }
    record cost { amount: string, currency: string }
    record budget { max-wall-time: u64, max-steps: u64, max-source-reads: u64, max-rows: u64, max-bytes: u64, max-model-calls: u64, max-input-tokens: u64, max-output-tokens: u64, max-cost: option<cost>, deadline: option<string> }
    record usage { elapsed: u64, steps: u64, source-reads: u64, rows: u64, bytes: u64, model-calls: u64, input-tokens: u64, output-tokens: u64, cost: option<cost> }
    enum diagnostic-severity { warning, error }
    record diagnostic { definition: definition-ref, field: list<string>, severity: diagnostic-severity, code: string, diagnostic-id: string }
    record bounding-box { left: f64, bottom: f64, right: f64, top: f64 }
    record text-anchor { start: u64, end: u64 }
    record pdf-anchor { page: u32, bbox: option<bounding-box> }
    record html-anchor { node-path: option<string>, text-start: u64, text-end: u64 }
    record sheet-anchor { sheet: string, row: u32, column: u32 }
    record part-anchor { part: string, element: option<string> }
    record media-anchor { start-ms: option<u64>, end-ms: option<u64> }
    record record-anchor { namespace: string, native-key: string, fields: list<string> }
    variant source-anchor { text(text-anchor), pdf(pdf-anchor), html(html-anchor), sheet(sheet-anchor), package-part(part-anchor), media(media-anchor), %record(record-anchor) }
    enum record-error { invalid-number, invalid-date, invalid-formula, precision-lost, unsupported-value, permission-denied }
    variant record-cell { missing, known(value), error(record-error) }
    record formula-value { expression: string, cached: option<value>, cache-current: bool }
    record source-field { id: string, name: string, value: record-cell, raw-lexeme: option<string>, formula: option<formula-value>, locator: option<source-anchor> }
    record source-row { native-key: string, incarnation: string, fields: list<source-field> }
    enum unary-operator { not, negate }
    enum binary-operator { equal, not-equal, less, less-or-equal, greater, greater-or-equal, add, subtract, multiply, divide, contains }
    enum aggregate-operator { count, sum, minimum, maximum, average, any, all }
    record sliding-window { width: u64, timestamp-property: definition-ref }
    variant time-window { fixed(valid-time), sliding(sliding-window) }
    record field-expression { subject: string, property: definition-ref }
    record role-expression { relation: string, role: string }
    record unary-expression { operator: unary-operator, operand: u32 }
    record binary-expression { operator: binary-operator, left: u32, right: u32 }
    record conditional-expression { condition: u32, then-value: u32, else-value: u32 }
    record call-expression { function: definition-ref, arguments: list<u32> }
    record aggregate-expression { operator: aggregate-operator, collection: string, expression: u32, window: option<time-window> }
    variant expression-node { literal(value), parameter(string), field(field-expression), role(role-expression), unary(unary-expression), binary(binary-expression), all(list<u32>), any(list<u32>), conditional(conditional-expression), call(call-expression), aggregate(aggregate-expression), is-null(u32), is-known(u32) }
    record expression { nodes: list<expression-node>, root: u32 }
    record source-order { field: string, descending: bool }
    record source-read-request { binding: definition-ref, %resource: string, row-symbol: string, fields: list<string>, predicate: option<expression>, order: list<source-order>, limit: u32, continuation: option<string>, as-of: option<string> }
    record source-page { rows: list<source-row>, basis: source-basis, continuation: option<string>, complete: bool }
    enum source-capability { schema-discovery, snapshot, history, change-stream, conditional-write, idempotency, inspect-effect, filter, sort, aggregate }
    variant resource-ref { object(string), relation(string), definition(string), assertion(string), evidence(string), support(string), watch(string), head(string), state(string), binding(string), operation(string), source(string), %package(string), change-set(string), branch(string), task(string), %case(string), test-case(string), suite(string), evaluation(string) }
    record revision-conflict { expected: u64, actual: u64 }
    record resource-revision-conflict { %resource: resource-ref, expected: u64, actual: u64 }
    record epoch-changed { policy-epoch: u64, grant-epoch: u64 }
    variant authorization-failure { invalid-principal, invalid-delegation, insufficient-scope, revoked, audience-mismatch, request-digest-mismatch, deadline-expired, replay, approval-missing, approval-expired, approval-digest-mismatch, required-policy-unavailable(string), policy-contract-mismatch(string), epoch-changed(epoch-changed), obligation-unsatisfied, internal-fault }
    enum installation-failure { unsupported-version, extension-unavailable, permission-denied, schema-mismatch, storage-identity-mismatch }
    enum constraint-code { database-constraint, identity-alias, immutable-revision, idempotency-payload, support-cycle, head-generation, state-epoch, foreign-reference, scope-overlap }
    variant commit-failure { installation(installation-failure), not-configured, closed, connection, pool-timeout, statement-timeout, serialization-conflict, deadlock, rollback-failed, commit-id-payload-conflict(string), invalid-batch, read-dependency-changed(resource-ref), constraint-conflict(constraint-code), revision-conflict(resource-revision-conflict), rolled-back, fenced(revision-conflict), commit-indeterminate(string), transfer-indeterminate(string), internal-fault }
    enum source-plan-reason { empty, unknown-resource, unknown-field, field-not-readable, field-not-writable, invalid-key, invalid-identifier, invalid-endpoint, unsupported-predicate, unsupported-ordering, unsupported-history, unsupported-limit, invalid-value, capability-not-declared }
    record invalid-plan { field: list<string>, reason: source-plan-reason }
    record digest-mismatch { expected: string, actual: string }
    enum source-credential-reason { missing, resolver-unavailable, resolver-authentication, decrypt-failed, invalid, store-unavailable }
    variant source-failure-leaf { authorization(authorization-failure), commit(commit-failure), binding(binding-failure), compile(compile-failure), mapping(mapping-failure), release(release-failure-leaf), lifecycle(lifecycle-failure), %package(package-failure), concurrent-call-limit, budget-exceeded(budget-dimension), invalid-plan(invalid-plan), connection-missing(string), revision-conflict(revision-conflict), sql-state(string), response-invalid(list<string>), response-limit, effect-indeterminate(string), credential(source-credential-reason), authentication, permission-denied, connection, connect-timeout, read-timeout, rate-limited(option<u64>), service-unavailable, unsupported-field(string), history-unavailable, capability-missing(source-capability), schema-drift(digest-mismatch), checkpoint-incompatible(string), position-expired, position-incomparable, incomplete-transaction, reader-not-stopped, ack-channel-not-stopped, epoch-stale(revision-conflict), gap(gap-reason), protocol-violation, upstream-unrecognized(string), cancelled, internal-fault }
    record source-cleanup { primary: option<u32>, code: string }
    record source-release-backfill { release-id: string, partition: string, failure: u32 }
    variant source-failure-node { leaf(source-failure-leaf), cleanup(source-cleanup), release-backfill(source-release-backfill), plugin-invocation(u32), host(host-failure-node), operation(operation-failure-node), slot(slot-failure-node), query(query-failure-node), action(action-failure-node), release(release-failure-node) }
    record source-failure { nodes: list<source-failure-node>, root: u32 }
    record projection-source-witness { basis: source-basis, cell: projected-cell }
    record projection-request { %world: world-ref, release-id: string, definitions: list<definition-definition-body>, scopes: list<scope>, scope: string, valid-time: valid-time, known-at: option<string>, cells: list<projected-cell>, fixed: list<projected-cell>, assertions: list<assertion>, sources: list<projection-source-witness>, basis: list<source-basis>, dependencies: list<read-dependency>, budget: budget }
    record projection-result { cells: list<projected-cell>, dependencies: list<read-dependency>, diagnostics: list<diagnostic> }
    variant projection-failure { invalid-input(list<string>), basis-changed, budget-exceeded, cancelled, internal-fault }
    record reconcile-request { %world: world-ref, release-id: string, definitions: list<definition-definition-body>, scopes: list<scope>, scope: string, valid-time: valid-time, known-at: option<string>, cells: list<projected-cell>, fixed: list<projected-cell>, assertions: list<assertion>, sources: list<projection-source-witness>, basis: list<source-basis>, dependencies: list<read-dependency>, budget: budget }
    record reconcile-result { selected: list<assertion-ref>, conflicts: list<projected-cell>, observations: list<observation-draft>, dependencies: list<read-dependency> }
    variant reconcile-failure { invalid-input(list<string>), authority-missing, basis-changed, budget-exceeded, cancelled, internal-fault }
    record oracle-query-observation { step-id: string, page: query-page }
    record oracle-request { %world: world-ref, test-case-id: string, fixture: list<u8>, expected: list<u8>, observed: list<u8>, queries: list<oracle-query-observation>, budget: budget }
    record oracle-result { passed: bool, evidence: list<evidence-ref>, diagnostics: list<diagnostic>, evidence-satisfied: option<u64>, evidence-required: option<u64>, conflicts-detected: option<u64>, conflicts-present: option<u64> }
    enum oracle-failure { bad-fixture, schema-mismatch, unavailable, budget-exceeded, cancelled, internal-fault }
    record config-value { name: string, value: value }
    record package-config { install-id: string, revision: u64, digest: string, fields: list<config-value> }
    enum config-read-failure { unavailable, digest-mismatch, authorization-revoked }
    record binding-failure-lock-retiring { activation-lock-id: string }
    record binding-failure-retained-references { activation-lock-id: string }
    record binding-failure-missing-activation-lock { activation-lock-id: string }
    record binding-failure-package-unavailable { node-id: string, install-id: string }
    record binding-failure-quarantined { node-id: string }
    record binding-failure-configuration-changed { node-id: string }
    enum publication-conflict-reason { empty-scope, resolution-mismatch, rollback-unproven }
    record binding-failure-publication-conflict { reason: publication-conflict-reason }
    record binding-failure-duplicate-port { node-id: string, port: string }
    record binding-failure-ambiguous-provider { consumer: string, port: string, providers: list<string> }
    record binding-failure-invalid-channels { binding-id: string }
    record binding-failure-duplicate-node { node-id: string }
    record binding-failure-missing-node { node-id: string }
    record binding-failure-missing-required-provider { consumer: string, contract: contract-ref }
    record binding-failure-missing-port { node-id: string, port: string }
    record binding-failure-contract-mismatch { consumer: string, provider: string, contract: contract-ref }
    record binding-failure-schema-mismatch { consumer: string, provider: string }
    record binding-failure-dependency-cycle { nodes: list<string> }
    record binding-failure-dataflow-cycle { nodes: list<string> }
    record binding-failure-invalid-composition { binding-id: string }
    enum slot-kind { connector, identity, schema, resolver, projection, provenance, compiler, policy, action, reconcile, abstraction, evaluation, context, agent-bridge, storage }
    enum merge-policy { none, ordered-concatenation, disjoint-fields, require-equal, explicit-conflict, mandatory-and-deny-overrides }
    record binding-failure-composition-unsupported-merge { slot: slot-kind, policy: merge-policy }
    record binding-failure-composition-merge-conflict { nodes: list<string> }
    record binding-failure-composition-incomplete { nodes: list<string> }
    record binding-failure-composition-blocked { dependencies: list<string> }
    record binding-failure-merge-policy-required { binding-id: string }
    record binding-failure-trust-boundary { node-id: string }
    record binding-failure-state-conflict { node-id: string }
    record binding-failure-head-conflict { expected: u64, actual: u64 }
    record binding-failure-commit { failure: commit-failure }
    variant binding-failure { lock-retiring(binding-failure-lock-retiring), retained-references(binding-failure-retained-references), missing-activation-lock(binding-failure-missing-activation-lock), package-unavailable(binding-failure-package-unavailable), quarantined(binding-failure-quarantined), configuration-changed(binding-failure-configuration-changed), head-invalid, publication-conflict(binding-failure-publication-conflict), lock-identity-conflict, duplicate-port(binding-failure-duplicate-port), ambiguous-provider(binding-failure-ambiguous-provider), invalid-channels(binding-failure-invalid-channels), invalid-roots, duplicate-node(binding-failure-duplicate-node), missing-node(binding-failure-missing-node), missing-required-provider(binding-failure-missing-required-provider), missing-port(binding-failure-missing-port), contract-mismatch(binding-failure-contract-mismatch), schema-mismatch(binding-failure-schema-mismatch), dependency-cycle(binding-failure-dependency-cycle), dataflow-cycle(binding-failure-dataflow-cycle), invalid-composition(binding-failure-invalid-composition), composition-unsupported-merge(binding-failure-composition-unsupported-merge), composition-merge-conflict(binding-failure-composition-merge-conflict), composition-incomplete(binding-failure-composition-incomplete), composition-blocked(binding-failure-composition-blocked), merge-policy-required(binding-failure-merge-policy-required), trust-boundary(binding-failure-trust-boundary), state-conflict(binding-failure-state-conflict), digest-mismatch, head-conflict(binding-failure-head-conflict), commit(binding-failure-commit), internal-fault }
    record lifecycle-failure-missing-install { install-id: string }
    record lifecycle-failure-missing-configuration { install-id: string }
    record lifecycle-failure-missing-trust { install-id: string }
    record lifecycle-failure-concurrent-call-limit { node-id: string }
    record lifecycle-failure-dependency-missing { node-id: string }
    record lifecycle-failure-prepare-failed { node-id: string }
    enum lifecycle-stage { prepare, acquire, close-acquisition, revoke, cancel, join, cleanup, stop-engine, stop-process, commit, recover }
    enum resource-kind { invocation, dependency, registration, %stream, body, host-io, callback, timer, child-call, task-join, store, process, private-material }
    enum resource-failure-stage { acquisition, admission, cancel, stop, shutdown, supervisor-join, task-join, material-cleanup, cleanup, completion }
    record resource-part-failure { kind: resource-kind, name: string, stage: resource-failure-stage, code: string, message: string }
    enum resource-stage { acquiring, running, joining, cleanup-failed }
    enum resource-failure-reason { acquisition-closed, dependency-missing, authorization-revoked, cleanup-failed, join-failed, engine-not-stopped, process-exit-unconfirmed, timeout }
    record retained-resource { parts: list<resource-part-failure>, token: string, generation-id: string, invocation-id: option<string>, acquisition-id: option<string>, kind: resource-kind, stage: resource-stage, reason: resource-failure-reason }
    record lifecycle-failure-retained { stage: lifecycle-stage, remaining-resources: list<retained-resource> }
    record lifecycle-failure-state-migration-required { migration-id: string }
    record lifecycle-failure-revision-conflict { expected: u64, actual: u64 }
    record lifecycle-failure-commit { failure: commit-failure }
    variant lifecycle-failure { missing-install(lifecycle-failure-missing-install), missing-configuration(lifecycle-failure-missing-configuration), missing-trust(lifecycle-failure-missing-trust), invalid-persisted-state, already-prepared, concurrent-call-limit(lifecycle-failure-concurrent-call-limit), acquisition-closed, dependency-missing(lifecycle-failure-dependency-missing), authorization-revoked, prepare-failed(lifecycle-failure-prepare-failed), retained(lifecycle-failure-retained), state-migration-required(lifecycle-failure-state-migration-required), revision-conflict(lifecycle-failure-revision-conflict), commit(lifecycle-failure-commit), internal-fault }
    record package-failure-authorization { failure: authorization-failure }
    enum config-failure { unknown-field, duplicate-field, required-field, type-mismatch, immutable, secret-field }
    record package-failure-config-invalid { field: list<string>, reason: config-failure }
    record package-failure-manifest-invalid { field: list<string> }
    record package-failure-file-missing { path: string }
    record package-failure-unlisted-file { path: string }
    record package-failure-size-mismatch { path: string }
    record package-failure-digest-mismatch { path: string }
    record package-failure-contract-mismatch { contract-id: string }
    record package-failure-artifact-invalid { artifact-id: string }
    record package-failure-target-unavailable { artifact-id: string }
    record package-failure-dependency-missing { package-id: string }
    record package-failure-dependency-conflict { package-id: string }
    record package-failure-commit { failure: commit-failure }
    variant package-failure { authorization(package-failure-authorization), config-invalid(package-failure-config-invalid), cancelled, invalid-archive, archive-limit, unsupported-compression, encrypted-archive, invalid-path, duplicate-path, case-collision, link-entry, manifest-missing, manifest-invalid(package-failure-manifest-invalid), unsupported-format, invalid-version, file-missing(package-failure-file-missing), unlisted-file(package-failure-unlisted-file), size-mismatch(package-failure-size-mismatch), digest-mismatch(package-failure-digest-mismatch), contract-mismatch(package-failure-contract-mismatch), wit-invalid, schema-invalid, artifact-invalid(package-failure-artifact-invalid), target-unavailable(package-failure-target-unavailable), dependency-missing(package-failure-dependency-missing), dependency-conflict(package-failure-dependency-conflict), dependency-cycle, signature-missing, signature-invalid, publisher-untrusted, process-not-trusted, native-not-trusted, io-read, io-write, io-sync, install-conflict, retained-references, cleanup-failed, commit(package-failure-commit), internal-fault }
    record mapping-failure-schema-missing { reference: schema-ref }
    record mapping-failure-mapping-changed { reference: mapping-ref }
    record mapping-failure-field-removed { field: string }
    record mapping-failure-field-renamed { field: string }
    record mapping-failure-field-type-changed { field: string }
    record mapping-failure-precision-changed { field: string }
    record mapping-failure-invalid-value { field: string, reason: record-error }
    record mapping-failure-type-mismatch { property: definition-ref }
    record mapping-failure-unit-mismatch { property: definition-ref }
    record mapping-failure-null-not-allowed { property: definition-ref }
    record mapping-failure-formula-unavailable { field: string }
    record mapping-failure-permission-denied { field: option<string> }
    record mapping-failure-capability-missing { capability: source-capability }
    enum budget-dimension { wall-time, steps, source-reads, rows, bytes, model-calls, input-tokens, output-tokens, cost, deadline }
    record mapping-failure-budget-exceeded { dimension: budget-dimension }
    variant mapping-failure { schema-missing(mapping-failure-schema-missing), mapping-changed(mapping-failure-mapping-changed), identity-unresolved, identity-ambiguous, incomplete-key, duplicate-key, field-removed(mapping-failure-field-removed), field-renamed(mapping-failure-field-renamed), field-type-changed(mapping-failure-field-type-changed), precision-changed(mapping-failure-precision-changed), invalid-value(mapping-failure-invalid-value), type-mismatch(mapping-failure-type-mismatch), unit-mismatch(mapping-failure-unit-mismatch), null-not-allowed(mapping-failure-null-not-allowed), formula-unavailable(mapping-failure-formula-unavailable), permission-denied(mapping-failure-permission-denied), capability-missing(mapping-failure-capability-missing), authority-mismatch, revision-mismatch, cross-world, budget-exceeded(mapping-failure-budget-exceeded), cancelled, internal-fault }
    record release-failure-leaf-branch-missing { branch-id: string }
    record release-failure-leaf-release-missing { release-id: string }
    record release-failure-leaf-branch-conflict { branch-id: string, expected: u64, actual: u64, fields: list<list<string>> }
    record release-head { %world: world-ref, channel: string, generation: u64, revision: u64, release-id: string }
    record release-failure-leaf-head-conflict { channel: string, expected: option<release-head>, actual: option<release-head> }
    record merge-conflict { definition-id: string, fields: list<list<string>> }
    record release-failure-leaf-merge-conflicts { conflicts: list<merge-conflict> }
    record release-failure-leaf-basis-changed { resources: list<resource-ref> }
    record release-failure-leaf-evaluation-required { suites: list<string> }
    record release-failure-leaf-backfill-not-ready { release-id: string, partitions: list<string> }
    record release-failure-leaf-invalid-branch { field: list<string> }
    record release-failure-leaf-invalid-artifact { field: list<string> }
    record release-failure-leaf-evaluation-missing { evaluation-id: string }
    record release-failure-leaf-evaluation-rejected { evaluation-id: string }
    record release-failure-leaf-authorization { failure: authorization-failure }
    record compile-failure-reference-missing { reference: definition-ref, field: list<string> }
    record compile-failure-reference-ambiguous { id: string, field: list<string> }
    record compile-failure-dependency-cycle { path: list<definition-ref> }
