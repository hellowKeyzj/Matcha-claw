interface world-read {
    use types.{query-request, query-page, failure-host-failure};
    query: func(request: query-request) -> result<query-page, failure-host-failure>;
}
interface model {
    use types.{generation-request, generation-receipt, failure-host-failure};
    generate: func(request: generation-request) -> result<generation-receipt, failure-host-failure>;
}
interface state {
    use types.{state-read, state-write, state-value, failure-host-failure};
    read: func(request: state-read) -> result<option<state-value>, failure-host-failure>;
    write: func(request: state-write) -> result<state-value, failure-host-failure>;
}
interface clock {
    use types.{failure-host-failure};
    now: func() -> result<string, failure-host-failure>;
}
interface logging {
    use types.{log-record, failure-host-failure};
    log: func(%record: log-record) -> result<_, failure-host-failure>;
}

interface state-migration {
    use types.{state-migration-input, state-migration-output, state-failure};
    migrate: func(request: state-migration-input) -> result<state-migration-output, state-failure>;
}
world state-migration-plugin {
    export state-migration;
}
