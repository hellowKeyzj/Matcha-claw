    record discover-query { include-capabilities: bool }
    record explain-query { assertion: assertion-ref, read-mode: read-mode }
    record approval-binding { approval-id: string, action-digest: string, impact-digest: string, contract: definition-ref, expires-at: string }
    record action-submit-request { %world: world-ref, proposal-id: string, proposal-digest: string, idempotency-key: string, approval: option<approval-binding> }
    record operation-key { %world: world-ref, operation-id: string }
    record observe-request { observations: list<observation-draft> }
    record task-ref { %world: world-ref, id: string, revision: u64 }
    record abstractions-query { task: task-ref, page: page-request }
    record world-view-query { task: task-ref, query: query-request, budget: budget }
    record external-contract-use-definition-kind { name: string }
    record external-contract-use-function { reference: definition-ref }
    record external-contract-use-source { binding: definition-ref }
    record external-contract-use-policy { policy-id: string, revision: u64 }
    variant external-contract-use { definition-kind(external-contract-use-definition-kind), function(external-contract-use-function), source(external-contract-use-source), policy(external-contract-use-policy), compiler-pass }
    record external-contract-selection { node-id: string, contract-id: string, kind: external-contract-use }
    record compile-selection { activation-lock-id: string, external-contracts: list<external-contract-selection> }
    record semantic-operation-no-op { reason: string }
    record semantic-operation-attach-evidence { target: resource-ref, evidence: list<evidence-ref> }
    record annotation { label: option<string>, description: option<string>, aliases: list<string> }
    record semantic-operation-enrich-annotation { target: definition-ref, annotation: annotation }
    record definition-definition-body { reference: definition-ref, scope: string, valid-time: valid-time, body: definition-body, content-digest: string, dependencies: list<definition-ref>, evidence: list<evidence-ref>, previous-ref: option<definition-ref>, lifecycle: definition-lifecycle }
    record kind-contract { name: string, standard-kind: option<definition-kind>, schema: contract-ref, validate: contract-ref, lower: contract-ref, index: contract-ref, migrate: contract-ref, reducer: contract-ref, lifecycle: contract-ref }
    enum kind-verb { create, refine, deprecate, split }
    record kind-operation-reducer { verb: kind-verb }
    variant kind-operation { validate, lower-standard, index, migrate, reducer(kind-operation-reducer), lifecycle }
    record kind-request { kind: kind-contract, definition: definition-definition-body, previous: option<definition-definition-body>, definitions: list<definition-definition-body>, scopes: list<scope>, operation: kind-operation }
    record kind-result-lowered { body: definition-body }
    record kind-result-indexed { dependencies: list<definition-ref> }
    record kind-result-migrated { definition: definition-definition-body }
    record kind-result-reduced { definition: definition-definition-body }
    variant kind-result { validated, lowered(kind-result-lowered), indexed(kind-result-indexed), migrated(kind-result-migrated), reduced(kind-result-reduced), lifecycle-checked }
    record kind-response { contract: contract-ref, %result: kind-result }
    record semantic-operation-refine-definition { previous: definition-ref, replacement: definition-definition-body }
    record semantic-operation-scope-definition { previous: definition-ref, scope: string, valid-time: valid-time }
    record semantic-operation-supersede-rule { previous: definition-ref, replacement: definition-definition-body }
    enum semantic-link { equivalent-within-scope, specializes, implements, depends-on }
    record semantic-operation-link-existing { source: definition-ref, target: definition-ref, relation: semantic-link }
    record semantic-operation-merge-aliases { sources: list<definition-ref>, target: definition-ref, evidence: list<evidence-ref> }
    record semantic-operation-deprecate-definition { previous: definition-ref, replacements: list<definition-ref>, reason: string, effective-at: string }
    record split-partition { replacement: string, predicate: expression }
    record semantic-operation-split-definition { previous: definition-ref, replacements: list<definition-definition-body>, partition: list<split-partition> }
    record semantic-operation-create-definition { definition: definition-definition-body }
    variant semantic-operation { no-op(semantic-operation-no-op), attach-evidence(semantic-operation-attach-evidence), enrich-annotation(semantic-operation-enrich-annotation), refine-definition(semantic-operation-refine-definition), scope-definition(semantic-operation-scope-definition), supersede-rule(semantic-operation-supersede-rule), link-existing(semantic-operation-link-existing), merge-aliases(semantic-operation-merge-aliases), deprecate-definition(semantic-operation-deprecate-definition), split-definition(semantic-operation-split-definition), create-definition(semantic-operation-create-definition) }
    record propose-change { task: task-ref, compile: compile-selection, base-release: string, operations: list<semantic-operation>, evidence: list<evidence-ref>, cases: list<string> }
    record suite-ref { %world: world-ref, id: string, revision: u64 }
    record test-branch { branch: branch-ref, suite: suite-ref, budget: budget }
    variant peer-operation { discover(discover-query), query(query-request), explain(explain-query), action-propose(action-proposal-request), action-submit(action-submit-request), action-status(operation-key), observe(observe-request), change-propose(propose-change), branch-test(test-branch) }
    record peer-request { %world: world-ref, request-id: string, operation: peer-operation }
    record agent-bridge-request { peer: peer-request, deadline: string }
    enum world-status { not-configured, ready, draining, restoring, deleting, retained, unavailable }
    enum port-direction { %import, %export }
    record method-port { name: string, contract: contract-ref, request-schema: string, result-schema: string, direction: port-direction, required: bool }
    record state-binding { namespace: string, root: revision-ref, schema: string, writer-domain: string, writer-epoch: u64, migration: option<string> }
    enum trust-class { ordinary-guest, trusted-native, trusted-process, private-root }
    record binding-node { id: string, provider-id: string, binding-id: string, slot: slot-kind, implementation: implementation-ref, ports: list<method-port>, required: bool, state: option<state-binding>, trust: trust-class }
    record binding-edge { consumer: string, consumer-port: string, provider: string, provider-port: string, contract: contract-ref, required: bool }
    enum composition-mode { single, ordered, chain, typed-dag, fan-out }
    enum dataflow-projection { compiler-ir }
    record dataflow-edge { projection: dataflow-projection, output-node: string, output-port: string, input-node: string, input-port: string, schema-digest: string }
    enum composition-failure-policy { fail-closed, collect-independent }
    record composition { binding-id: string, nodes: list<string>, mode: composition-mode, order: list<string>, wiring: list<dataflow-edge>, merge: merge-policy, failure: composition-failure-policy }
    record activation-lock { %world: world-ref, id: string, digest: string, nodes: list<binding-node>, edges: list<binding-edge>, compositions: list<composition>, roots: list<string>, trusted-roots: list<string> }
    record scope { %world: world-ref, id: string, predicate: expression }
    record external-contract-kind-definition-kind { name: string }
    record external-contract-kind-function { reference: definition-ref }
    record external-contract-kind-source { binding: definition-ref, capabilities: list<source-capability> }
    record external-contract-kind-policy { policy: policy-ref }
    record external-contract-kind-compiler-pass { pass-id: string }
    variant external-contract-kind { definition-kind(external-contract-kind-definition-kind), function(external-contract-kind-function), source(external-contract-kind-source), policy(external-contract-kind-policy), compiler-pass(external-contract-kind-compiler-pass) }
    record external-contract { contract: contract-ref, implementation: implementation-ref, kind: external-contract-kind }
    record compile-request { %world: world-ref, base-release: string, activation-lock: activation-lock, definitions: list<definition-definition-body>, scopes: list<scope>, targets: list<compile-target>, external-contracts: list<external-contract>, config-digest: string }
    record access-policy-ref { policy-id: string, revision: u64, labels: list<string> }
    record material-scope { scope: string, access: list<access-policy-ref>, retention: list<retention-policy> }
    enum read-guarantee { projected, authoritative, after }
    record world-description { %world: world-ref, revision: u64, incarnation: u64, status: world-status, operations: list<string>, active-release: option<string>, active-release-head: option<release-head>, editing-context: option<compile-request>, material-scopes: list<material-scope>, read-modes: list<read-guarantee> }
    record explanation-graph { conclusion: assertion-ref, revision: u64, supports: list<support-set>, visible-evidence: list<evidence-ref> }
    record operation-accepted { %world: world-ref, operation-id: string, revision: u64, incarnation: u64 }
    enum action-phase { proposed, admitted, prepared, dispatching, effect-pending, verifying, committing, completed, rejected, cancelled-before-effect, cancelled-after-effect, effect-indeterminate, commit-indeterminate, compensating, retained }
    record source-receipt { id: string, intent-id: string, source-id: string, observed-at: string, disposition: effect-disposition, position: option<source-position>, %result: option<value>, evidence: list<evidence-ref> }
    enum verification-verdict { verified, not-satisfied, inconclusive }
    record verification-receipt { id: string, intent-id: string, verdict: verification-verdict, read-receipt: read-receipt, evidence: list<evidence-ref>, verified-at: string }
    record committed-revision { %resource: resource-ref, revision: u64 }
    record write-fence { %world: world-ref, domain: string, epoch: u64 }
    record commit-receipt { %world: world-ref, commit-id: string, committed-at: string, revisions: list<committed-revision>, outbox-ids: list<string>, fence: write-fence }
    record failure-action-failure { code: string, stage: failure-stage, message: string, diagnostic-id: string, operation-id: option<string>, run-id: option<string>, step-id: option<string>, details: action-failure, recovery: recovery }
    record action-status { operation-id: string, run-id: string, phase: action-phase, source-receipts: list<source-receipt>, verifications: list<verification-receipt>, commit: option<commit-receipt>, failure: option<failure-action-failure> }
    enum change-status { proposed, validated, testing, ready, rejected, published, superseded }
    record change-set { %world: world-ref, id: string, revision: u64, base-release: string, operations: list<semantic-operation>, evidence: list<evidence-ref>, cases: list<string>, rationale: string, status: change-status }
    variant peer-response { discover(world-description), query(query-page), explain(explanation-graph), action-propose(action-proposal), accepted(operation-accepted), action-status(action-status), change(change-set) }
    record agent-bridge-result { response: peer-response, native-run-id: option<string> }
    record storage-read-request { %world: world-ref, resources: list<resource-ref>, known-at: option<string> }
    record evidence-locator { source-version: source-version-ref, parse-artifact-id: option<string>, anchor: source-anchor }
    enum evidence-status { active, withdrawn, content-deleted }
    enum evidence-availability { available, unavailable }
    record evidence { reference: evidence-ref, locator: evidence-locator, digest: option<string>, origin-family: string, derived-from: list<evidence-ref>, observed-at: string, authority: option<authority-ref>, access: access-policy-ref, retention: retention-policy, status: evidence-status, availability: evidence-availability }
    record storage-read-result { assertions: list<assertion>, definitions: list<definition-definition-body>, evidence: list<evidence>, revisions: list<committed-revision> }

    // BEGIN canonical materials worker types
    // Source SHA-256: 757414e50ba52768190654573edab7c2651e9e3a4d4dff428482c3ed4ca52f82
    // Contract: world.materials.v1@1.0.0 sha256:9cd8cfdbd58fe73ecbf09fa1ef1abbc5fb68b220cb64e3f4d3e3817a5a57060e
    // Core arena types are shared; numeric wire projections require checked native conversion.
    record artifact-manifest { activation-lock-id: string, config-digest: string, dependencies: dependency-graph, digest: string, id: string, ir-version: string, model-digest: string, outputs: list<artifact-output>, release-id: string, targets: list<compile-target>, %world: world-ref }
    record artifact-output { content: blob-ref, contract: contract-ref, definition: option<definition-ref>, kind: compile-target, schema-digest: string }
    variant block-kind { paragraph, heading(block-kind-heading), list-item, quote, code(block-kind-code), rule, table(block-kind-table), note }
    record block-kind-code { language: option<string> }
    record block-kind-heading { level: u8 }
    record block-kind-table { table-id: string }
    record candidate { change-set: change-set, created-at: string, evidence: list<evidence>, id: string, model-calls: list<string>, origin: candidate-origin, %world: world-ref }
    record candidate-batch { candidates: list<candidate>, coverage: list<coverage-entry>, evidence: list<evidence>, observations: list<observation-draft>, read-needs: list<read-need> }
    enum candidate-origin { direct, human, extraction, case-induction, reconciliation, abstraction }
    record coverage-entry { anchor: option<source-anchor>, reason: option<coverage-reason>, status: coverage-status }
    variant coverage-reason { parsed, ocr-unavailable, transcription-unavailable, page-missing, timing-unavailable, location-unavailable, precision-unavailable, raw-value-unavailable, binary-float-precision, formula-unavailable, asset-extraction-disabled, asset-filtered, asset-decode-failed, asset-encode-failed, image-limit(coverage-reason-image-limit), text-unavailable, chapter-unavailable, parser-recovery(coverage-reason-parser-recovery), upstream-recovery-not-reported, lossy-text-decoding, sheet-read-failed, unsupported-element, resource-limit, corrupt-element, fallback-parser }
    record coverage-reason-image-limit { limit: u64 }
    record coverage-reason-parser-recovery { failure: option<parse-failure-kind>, parser: string }
    enum coverage-status { processed, missing, failed, truncated, fallback }
    record document-asset { blob: blob-ref, derivation: option<string>, derived-from: list<string>, height: option<u32>, id: string, media-type: string, source-anchor: option<source-anchor>, source-digest: option<string>, width: option<u32> }
    record document-block { id: string, kind: block-kind, parent: option<string>, text: string }
    variant document-cell-value { missing, null, text(string), boolean(bool), integer(string), decimal(string), float(f64), date-time(document-cell-value-date-time), date-time-iso(string), duration-iso(string), error(string), covered(document-cell-value-covered) }
    record document-cell-value-covered { column: u32, row: u32 }
    record document-cell-value-date-time { display: string, serial: f64 }
    record document-chunk { anchors: list<source-anchor>, context-targets: list<document-target>, id: string, parse-artifact-id: string, primary-targets: list<document-target>, source-version: source-version-ref, token-estimate: u64 }
    record document-chunk-content { assets: list<document-asset>, blocks: list<document-text-slice>, chunk: document-chunk, coverage: list<coverage-entry>, source-map: list<source-map-entry>, tables: list<document-table> }
    record document-table { cells: list<table-cell>, header-rows: u32, id: string, name: option<string> }
    variant document-target { block(document-target-block), cell(document-target-cell), asset(document-target-asset) }
    record document-target-asset { asset-id: string }
    record document-target-block { block-id: string, end: u32, start: u32 }
    record document-target-cell { column: u32, row: u32, table-id: string }
    record document-text-slice { block-id: string, end: u32, kind: block-kind, parent: option<string>, start: u32, text: string }
    record generation-parameters { maximum-output-tokens: u64, seed: option<u64>, temperature: option<string>, top-p: option<string> }
    record image-options { full-page-coverage-ratio: f32, full-page-min-text-chars: u64, max-images: u64, min-height: u32, min-width: u32, skip-full-page-images: bool }
    variant material-request { parse(material-request-parse), chunks(material-request-chunks), read(material-request-read), prepare(material-request-prepare), finish(material-request-finish), align(material-request-align) }
    record material-request-align { base: release, batches: list<candidate-batch>, draft: candidate }
    record material-request-chunks { artifact: parse-artifact, base: release, binding: model-binding, budget: budget, run-id: string, scope: scope, source: source-version }
    record material-request-finish { artifact: parse-artifact, generation: generation-request, receipt: generation-receipt, request: semantic-extract-request, source: source-version }
    record material-request-parse { bytes: list<u8>, name: string, plan: parse-plan, source: source-version }
    record material-request-prepare { artifact: parse-artifact, binding: model-binding, request: semantic-extract-request, run-id: string, source: source-version, step-id: string }
    record material-request-read { artifact: parse-artifact, base: release, binding: model-binding, budget: budget, need: read-need, run-id: string, scope: scope, source: source-version }
    variant material-response { parse(material-response-parse), chunks(material-response-chunks), read(material-response-read), prepare(material-response-prepare), finish(material-response-finish), align(material-response-align) }
    record material-response-align { batch: candidate-batch }
    record material-response-chunks { chunks: list<document-chunk-content> }
    record material-response-finish { batch: candidate-batch }
    record material-response-parse { asset-bytes: list<list<u8>>, diagnostics: list<parser-diagnostic>, projection: parse-input }
    record material-response-prepare { context-bytes: list<list<u8>>, generation: generation-request, prompt-bytes: list<u8>, schema-bytes: list<u8> }
    record material-response-read { content: document-chunk-content }
    record model-binding { account-id: string, account-revision: u64, capabilities: option<model-capabilities>, capability: string, model-id: string, parameters: generation-parameters, protocol: string, provider-fingerprint: string, reference: model-binding-ref, remote-version-lock: remote-version-lock, selection-id: string }
    record model-capabilities { audio: bool, context-tokens: u64, images: bool, structured-output: bool, tools: bool }
    record parse-artifact { assets: list<document-asset>, blocks: list<document-block>, coverage: list<coverage-entry>, dependency-fingerprints: list<string>, id: string, manifest: blob-ref, metadata: list<tuple<string, string>>, options-digest: string, parse-run: string, parser-fingerprint: string, source-map: list<source-map-entry>, source-version: source-version-ref, tables: list<document-table>, %world: world-ref }
    enum parse-failure-kind { unsupported, corrupt, encrypted, parser-unavailable, resource-limit, cancelled, internal }
    record parse-input { assets: list<document-asset>, blocks: list<document-block>, coverage: list<coverage-entry>, dependency-fingerprints: list<string>, id: string, metadata: list<tuple<string, string>>, options-digest: string, parse-run: string, parser-fingerprint: string, source-map: list<source-map-entry>, source-version: source-version-ref, tables: list<document-table>, %world: world-ref }
    record parse-options { extract-assets: bool, images: image-options }
    record parse-plan { dependency-fingerprints: list<string>, id: string, options: parse-options, parse-run: string, parser-fingerprint: string }
    record parser-diagnostic { causes: list<string>, kind: parser-diagnostic-kind, limit: option<string> }
    enum parser-diagnostic-kind { unsupported, corrupt, encrypted, parser-unavailable, resource-limit, cancelled, internal }
    record read-need { parse-artifact-id: string, reason: read-need-reason, source-version: source-version-ref, targets: list<document-target> }
    enum read-need-reason { context-missing, identity-ambiguous, temporal-context-missing, value-context-missing }
    record release { artifact: artifact-manifest, basis: list<read-dependency>, definitions: list<definition-definition-body>, evaluations: list<string>, id: string, parent: option<string>, published-at: string, read-receipts: list<read-receipt>, scopes: list<scope>, source-branch: option<branch-ref>, sources: list<source-basis>, %world: world-ref }
    enum remote-version-lock { unlocked }
    record semantic-extract-request { base-release: string, budget: budget, content: document-chunk-content, definitions: list<definition-definition-body>, scope: scope, %world: world-ref }
    variant source-lineage { source-version(source-lineage-source-version), wiki-source(source-lineage-wiki-source), wiki-page(source-lineage-wiki-page), generated(source-lineage-generated) }
    record source-lineage-generated { inputs: list<source-version-ref>, run-id: string }
    record source-lineage-source-version { reference: source-version-ref }
    record source-lineage-wiki-page { page-id: string, project-id: string, source-versions: list<string>, version: string }
    record source-lineage-wiki-source { project-id: string, source-id: string, version: string }
    record source-map-entry { anchor: source-anchor, target: document-target }
    record source-version { access: access-policy-ref, blob: blob-ref, captured-at: string, lineage: list<source-lineage>, media-type: string, origin-family: string, reference: source-version-ref, retention: retention-policy, supersedes: option<source-version-ref> }
    record table-cell { column: u32, column-span: u32, formula: option<string>, precision: value-precision, raw: option<string>, row: u32, row-span: u32, value: document-cell-value }
    enum value-precision { exact, approximate, unavailable }
    variant worker-failure { material(worker-failure-material), learning(worker-failure-learning), compile(worker-failure-compile) }
    record worker-failure-compile { causes: list<string>, failure: compile-failure }
    record worker-failure-learning { causes: list<string>, failure: learning-failure }
    record worker-failure-material { causes: list<string>, failure: material-failure }
    // END canonical materials worker types
}

// Pure material-worker ABI: no storage, authority, model or effect imports.
interface materials {
    use types.{material-request, material-response, worker-failure};
    execute: func(request: material-request) -> result<material-response, worker-failure>;
}
world materials-worker { export materials; }

interface source {
    use types.{source-read-request, source-page, source-failure};
    read: func(request: source-read-request) -> result<source-page, source-failure>;
}
