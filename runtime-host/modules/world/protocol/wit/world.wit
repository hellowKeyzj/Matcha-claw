    reconcile: func(request: reconcile-request) -> result<reconcile-result, reconcile-failure>;
}
interface evaluation {
    use types.{oracle-request, oracle-result, oracle-failure};
    evaluate: func(request: oracle-request) -> result<oracle-result, oracle-failure>;
}
